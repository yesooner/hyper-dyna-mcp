# Dyna-mcp environment variables
# 复制此文件到项目根目录并重命名为 .env
# 然后根据你的实际环境修改以下路径

# HyperMesh 安装目录
# Windows 默认: "C:/Program Files/Altair/2024/hw/bin/win64"
HM_INSTALL_DIR=C:/Program Files/Altair/2024/hw/bin/win64

# LS-DYNA 求解器路径
# Windows 默认: "C:/Program Files/LSTC/ls-dyna_smp_d_R13.1_216-g83709a1_winx64_ifort190.exe"
LSDYNA_SOLVER=C:/Program Files/LSTC/ls-dyna_smp_d_R13.1_216-g83709a1_winx64_ifort190.exe

# LS-PrePost 可执行文件路径
# Windows 默认: "C:/Program Files/LSTC/LS-PrePost4.9/lsprepost4.9_x64.exe"
LSPREPOST_EXE=C:/Program Files/LSTC/LS-PrePost4.9/lsprepost4.9_x64.exe

# Obsidian 知识库根目录
# 示例: "D:/Zotero/ZoteroNote"
OBSIDIAN_ROOT=D:/Zotero/ZoteroNote

# 可选: 代理设置（如果需要）
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port
# NO_PROXY=localhost,127.0.0.1
