path/
!path/local_paths.yaml
!path/hypermesh_paths.yaml

# 测试目录
tests/

# 文档目录
docs/

# 输出目录
output/
!output/model_original.k
!output/model_roundtrip.k
!output/screenshots/.gitkeep

# 核心配置文件
!hmcustom.tcl
!pyproject.toml
!README.md
!README.en.md
!RELEASE_NOTES.md
!CLAUDE.md
!.gitignore
!LICENSE

