# ==================== 项目核心目录 ====================
# 只保留以下目录和文件，忽略其他所有内容

# 核心程序目录
program/
!program/server.py
!program/transport_manager.py
!program/plugin_loop.py
!program/tools/
!program/prompts/

# 关键字模板目录
templates/
