          "execution_allowed": false
        }
      ],
      "manual_refs": [
        {
          "ref_id": "manual_note:initial_detonation_overview",
          "source": "templates/dyna_manual_notes.jsonl",
          "role": "explanation_only"
        }
      ],
      "execution_ready": false,
      "notes": [
        "Cardimage route is present in templates/keyword/initial/INITIAL_DETONATION.tcl.",
        "Explosion initiation semantics require model-specific review; this route is not executable until datanames and required fields are recorded in HyperMesh."
      ]
    },
    "*LOAD_BLAST": {
      "status": "cardimage_verified",
      "keyword": "*LOAD_BLAST",
      "entity_type": "groups",
      "cardimage": "LOAD_BLAST",
      "hm_family": "LOAD",
      "fields": [
        {"field": "SID", "dataname": null, "status": "requires_hm_recording"}
