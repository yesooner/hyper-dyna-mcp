            "$#     sid",
            "$# blast load parameters must be supplied by the analyst and checked against units"
          ],
          "execution_allowed": false
        }
      ],
      "manual_refs": [
        {
          "ref_id": "manual_note:load_blast_overview",
          "source": "templates/dyna_manual_notes.jsonl",
          "role": "explanation_only"
        }
      ],
      "execution_ready": false,
      "notes": [
        "Cardimage route is present in templates/keyword/load/LOAD_BLAST.tcl.",
        "Blast load magnitude, source, and units must not be inferred from manual notes or embeddings."
      ]
    },
    "*DATABASE_BINARY_D3PLOT": {
      "status": "cardimage_verified",
      "keyword": "*DATABASE_BINARY_D3PLOT",
      "aliases": [
        "*DATABASE_D3PLOT"
      ],
      "entity_type": "cards",
      "cardimage": "DBplot",
      "hm_family": "DATABASE",
      "fields": [
        {"field": "DT", "dataname": null, "status": "requires_hm_recording"},
        {"field": "TSTART", "dataname": null, "status": "requires_hm_recording"},
        {"field": "TTERM", "dataname": null, "status": "requires_hm_recording"},
        {"field": "LCDT", "dataname": null, "status": "requires_hm_recording"}
      ],
      "examples": [
        {
          "purpose": "planning_only",
          "keyword_block": [
            "*DATABASE_BINARY_D3PLOT",
            "$#      dt    tstart     tterm      lcdt",
            "$# output cadence and time-window values must be chosen by the model author"
          ],
          "execution_allowed": false
        }
      ],
      "manual_refs": [
        {
          "ref_id": "manual_note:database_binary_d3plot_overview",
          "source": "templates/dyna_manual_notes.jsonl",
          "role": "explanation_only"
        }
      ],
      "execution_ready": false,
      "notes": [
        "Cardimage route is direct through hm_dictionary.cardmenuitem DATABASE_BINARY_D3PLOT -> DBplot.",
        "Datanames are intentionally not executable until verified by HyperMesh command recording.",
        "Do not use manual notes or embeddings to choose output timestep or write Tcl card fields."
      ]
    }
  },
  "execution_guardrails": {
    "require_known_keyword": true,
    "require_valid_cardimage": true,
    "require_valid_dataname": true,
    "allow_embedding_to_fill_execution_fields": false
  }
}
