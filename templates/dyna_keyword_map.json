      ],
      "manual_refs": [
        {
          "ref_id": "manual_note:control_termination_overview",
          "source": "templates/dyna_manual_notes.jsonl",
          "role": "explanation_only"
        }
      ],
      "execution_ready": false,
      "notes": [
        "Keyword and entity type are known from keyword_index.",
        "This route is retrieval/planning-only until HyperMesh control-card cardimage and datanames are verified.",
        "Do not use manual notes or embeddings to fill ENDTIM or other execution fields."
      ]
    },
    "*CONTROL_TIMESTEP": {
      "status": "cardimage_verified",
      "keyword": "*CONTROL_TIMESTEP",
      "entity_type": "cards",
      "cardimage": "Timestep",
      "hm_family": "CONTROL",
      "fields": [
        {"field": "DTINIT", "dataname": null, "status": "requires_hm_recording"},
        {"field": "TSSFAC", "dataname": null, "status": "requires_hm_recording"},
        {"field": "ISDO", "dataname": null, "status": "requires_hm_recording"},
        {"field": "TSLIMT", "dataname": null, "status": "requires_hm_recording"},
        {"field": "DT2MS", "dataname": null, "status": "requires_hm_recording"},
        {"field": "LCTM", "dataname": null, "status": "requires_hm_recording"},
        {"field": "ERODE", "dataname": null, "status": "requires_hm_recording"},
        {"field": "MS1ST", "dataname": null, "status": "requires_hm_recording"}
      ],
      "examples": [
        {
          "purpose": "planning_only",
          "keyword_block": [
            "*CONTROL_TIMESTEP",
            "$#  dtinit    tssfac      isdo    tslimt     dt2ms      lctm     erode     ms1st",
            "$# timestep controls affect stability and mass scaling; values require analyst review"
          ],
          "execution_allowed": false
        }
      ],
      "manual_refs": [
        {
          "ref_id": "manual_note:control_timestep_overview",
          "source": "templates/dyna_manual_notes.jsonl",
          "role": "explanation_only"
        }
      ],
      "execution_ready": false,
      "notes": [
        "Cardimage route is direct through hm_dictionary.cardmenuitem CONTROL_TIMESTEP -> TimeStep.",
        "Local template templates/keyword/control/CONTROL_TIMESTEP.tcl contains candidate datanames, but execution still requires HyperMesh command recording in the target profile.",
        "Do not let manual notes or embeddings choose timestep, mass scaling, or erosion controls."
      ]
    },
    "*INITIAL_DETONATION": {
      "status": "cardimage_verified",
      "keyword": "*INITIAL_DETONATION",
      "entity_type": "groups",
      "cardimage": "INITIAL_DETONATION",
