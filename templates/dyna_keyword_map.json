{
  "version": 1,
  "scope": "structured_dyna_keyword_execution_map",
  "policy": {
    "execution_source": "structured_map_only",
    "embedding_role": "explanation_and_retrieval_only",
    "notes": [
      "Do not execute Tcl or K-language actions from embedding results.",
      "Execution tools must resolve keyword, cardimage, and dataname through structured dictionaries first.",
      "Manual notes can explain fields and usage but must not override verified maps."
    ]
  },
  "sources": {
    "keyword_index": "templates/keyword_index.json",
    "hypermesh_dictionary": "templates/hm_dictionary.json",
    "manual_notes": "templates/dyna_manual_notes.jsonl"
  },
  "lookup_flow": [
    "keyword",
    "cardimage",
    "entity_type",
    "datanames",
    "fields",
    "examples",
    "manual_refs"
  ],
  "keyword_routes": {
    "*MAT_3": {
      "status": "cardimage_verified",
      "keyword": "*MAT_3",
      "aliases": [
        "*MAT_003",
        "*MAT_PLASTIC_KINEMATIC",
        "*MAT_036"
      ],
      "entity_type": "mats",
      "cardimage": "MATL3",
      "hm_family": "ELASTIC-PLASTIC",
      "fields": [
        {"field": "E", "dataname": null, "status": "requires_hm_recording"},
        {"field": "MID", "dataname": null, "status": "requires_hm_recording"},
        {"field": "PR", "dataname": null, "status": "requires_hm_recording"},
        {"field": "RHO", "dataname": null, "status": "requires_hm_recording"}
      ],
      "examples": [
        {
          "purpose": "planning_only",
          "keyword_block": [
            "*MAT_PLASTIC_KINEMATIC",
            "$#     mid        ro         e        pr      sigy      etan      beta",
            "$# values must be supplied by the model author and verified against the target unit system"
          ],
          "execution_allowed": false
        }
      ],
      "manual_refs": [
        {
          "ref_id": "manual_note:mat_3_plastic_kinematic",
          "source": "templates/dyna_manual_notes.jsonl",
          "role": "explanation_only"
        }
      ],
      "execution_ready": false,
      "notes": [
        "Cardimage route is direct through hm_dictionary.mats MATL3.",
        "Datanames are intentionally not executable until verified by HyperMesh card recording or a trusted local dictionary source.",
        "Do not use cross-card lsd_fields candidates as execution datanames."
      ]
    },
    "*SECTION_SOLID": {
      "status": "keyword_index_only",
      "keyword": "*SECTION_SOLID",
      "entity_type": "props",
      "cardimage": null,
      "fields": [
        {"field": "SECID", "dataname": null, "status": "requires_hm_recording"}
      ],
      "examples": [
        {
          "purpose": "planning_only",
          "keyword_block": [
            "*SECTION_SOLID",
            "$#   secid    elform      aet"
          ],
          "execution_allowed": false
        }
      ],
      "manual_refs": [
        {
          "ref_id": "manual_note:section_solid_overview",
          "source": "templates/dyna_manual_notes.jsonl",
          "role": "explanation_only"
        }
      ],
      "execution_ready": false,
      "notes": [
        "Keyword and entity type are known from keyword_index.",
        "Cardimage and datanames still require HyperMesh-side verification."
      ]
    },
    "*CONTROL_TERMINATION": {
      "status": "keyword_index_only",
      "keyword": "*CONTROL_TERMINATION",
      "entity_type": "cards",
      "cardimage": null,
      "fields": [
        {"field": "DTMIN", "dataname": null, "status": "requires_hm_recording"},
        {"field": "ENDCYC", "dataname": null, "status": "requires_hm_recording"},
        {"field": "ENDENG", "dataname": null, "status": "requires_hm_recording"},
        {"field": "ENDMAS", "dataname": null, "status": "requires_hm_recording"},
        {"field": "ENDTIM", "dataname": null, "status": "requires_hm_recording"}
