# Hyper-Dyna-MCP local environment template
# Copy to .env and replace placeholders with local paths.

HDM_HOME=C:/path/to/hyper-dyna-mcp
HDM_GUI_PORT=47883
HDM_AUTO_START=1
HDM_PYTHON_EXE=C:/path/to/conda/envs/hyper-dyna/python.exe

# Optional commercial software paths
HM_INSTALL_DIR=C:/path/to/Altair/hwdesktop
LSDYNA_SOLVER=C:/path/to/lsdyna.exe
LSPREPOST_EXE=C:/path/to/lsprepost.exe

# Optional note vault path
OBSIDIAN_ROOT=C:/path/to/obsidian-vault
